{
  "elements": [
    {
      "type": "Label",
      "caption": "This module simulates hour by hour how a battery storage affects grid import, feed-in and costs."
    },
    {
      "type": "Label",
      "caption": "Note: Correctly aggregated kWh values are essential for plausible results."
    },
    {
      "type": "ExpansionPanel",
      "caption": "1) Period",
      "items": [
        {
          "type": "Label",
          "caption": "Please define the evaluation period. A full year is typically used for a reliable statement."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "ValidationTextBox",
              "name": "StartDate",
              "caption": "Date from (YYYY-MM-DD HH:MM:SS)"
            },
            {
              "type": "ValidationTextBox",
              "name": "EndDate",
              "caption": "Date to (YYYY-MM-DD HH:MM:SS)"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "2) Data sources",
      "items": [
        {
          "type": "Label",
          "caption": "Select the meter variables for grid import and grid feed-in."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "SelectVariable",
              "name": "GridImportVarID",
              "caption": "Grid import meter"
            },
            {
              "type": "SelectVariable",
              "name": "GridExportVarID",
              "caption": "Grid feed-in meter"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Conversion factor to kWh (-): 1.0 for kWh values, 0.001 for Wh values."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "CounterUnitToKWh",
              "caption": "Conversion factor to kWh (-)",
              "digits": 4
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "3) Prices",
      "items": [
        {
          "type": "Label",
          "caption": "Enter the import price and the feed-in tariff in EUR/kWh."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "PriceImport",
              "caption": "Import price (EUR/kWh)",
              "digits": 4
            },
            {
              "type": "NumberSpinner",
              "name": "PriceExport",
              "caption": "Feed-in tariff (EUR/kWh)",
              "digits": 4
            }
          ]
        },
        {
          "type": "Label",
          "caption": "Optional: a dynamic import price from an archived variable (e.g. cent/kWh) overrides the fixed import price on an hourly basis."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "SelectVariable",
              "name": "ImportPriceVarID",
              "caption": "Dynamic import price variable"
            },
            {
              "type": "NumberSpinner",
              "name": "ImportPriceUnitToEur",
              "caption": "Conversion to EUR (e.g. 0.01 for cent)",
              "digits": 4
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "4) Battery parameters",
      "items": [
        {
          "type": "Label",
          "caption": "Technical data of the planned storage. Efficiencies as a value between 0 and 1."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "BatteryCapacity",
              "caption": "Usable capacity (kWh)",
              "digits": 3
            }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "BatteryMaxCharge",
              "caption": "Max. charge power (kW)",
              "digits": 3
            },
            {
              "type": "NumberSpinner",
              "name": "BatteryMaxDischarge",
              "caption": "Max. discharge power (kW)",
              "digits": 3
            }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "BatteryChargeEff",
              "caption": "Charge efficiency (-)",
              "digits": 4
            },
            {
              "type": "NumberSpinner",
              "name": "BatteryDischargeEff",
              "caption": "Discharge efficiency (-)",
              "digits": 4
            }
          ]
        },
        {
          "type": "NumberSpinner",
          "name": "BatteryInvest",
          "caption": "Investment (EUR)",
          "digits": 2
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "5) Plausibility",
      "items": [
        {
          "type": "Label",
          "caption": "If the calculated grid import falls below this value, a note about possibly wrong units or archive settings appears."
        },
        {
          "type": "NumberSpinner",
          "name": "LowImportWarningThreshold",
          "caption": "Warning threshold for low grid import (kWh/year)",
          "digits": 1
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Start calculation",
      "onClick": "PVBAT_Calculate($id);"
    }
  ],
  "status": [
    {
      "code": 201,
      "icon": "error",
      "caption": "Configuration incomplete"
    }
  ]
}
